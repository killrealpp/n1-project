APP_ENV=development
APP_TIMEZONE=Europe/Moscow
LOG_LEVEL=info
DB_PATH=data/n1_project.sqlite3
SOURCE_FETCH_MODE=mtproto
WORKER_POLL_SECONDS=300
WORKER_BATCH_LIMIT=10
TRANSLATION_MAX_ATTEMPTS=5

# Telegram: source watcher and target publishing bot.
TELEGRAM_BOT_TOKEN=1234567890:replace_me
TELEGRAM_TARGET_CHAT_ID=-1001234567890
TELEGRAM_SOURCE_CHANNEL_ID=@source_channel_or_-100_id
TELEGRAM_SOURCE_PUBLIC_NAME=num1_ch
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace_me
TELEGRAM_MTPROTO_SESSION_STRING=replace_me

# VK: wall.post target. For a community wall, VK_ID can be positive here;
# the publisher will send it as a negative owner_id.
VK_TOKEN=replace_me
VK_ID=123456789

# MAX: bot token and target chat/channel id.
MAX_ACCESS_TOKEN=replace_me
MAX_CHAT_ID=123456789
MAX_API_BASE_URL=https://platform-api2.max.ru
# If MAX TLS fails with CERTIFICATE_VERIFY_FAILED, point to a Russian trusted CA bundle.
# MAX_CA_BUNDLE=certs/russian_trusted_ca_bundle.pem

# Admin notifications. Dzen article review buttons are optional when enabled below.
ADMIN_TELEGRAM_CHAT_ID=<your_personal_telegram_user_id>
ADMIN_NOTIFICATIONS_ENABLED=true
ADMIN_CALLBACK_POLL_TIMEOUT_SECONDS=25

# Dzen: later stage. Publishing will go through a Telegram bridge chat/channel
# with the Dzen sync bot, so no direct Dzen API secrets are required yet.
DZEN_TELEGRAM_BRIDGE_CHAT_ID=-1001234567890
DZEN_ARTICLE_CHANNELS=markets
# Optional legacy per-channel bridge settings, kept for rollback/testing.
DZEN_RUSSIA_TELEGRAM_BRIDGE_CHAT_ID=-1001234567890
DZEN_ENERGY_TELEGRAM_BRIDGE_CHAT_ID=-1002345678901
DZEN_ENERGY_TELEGRAM_BOT_TOKEN=
DZEN_TECH_TELEGRAM_BRIDGE_CHAT_ID=-1003456789012
DZEN_TECH_TELEGRAM_BOT_TOKEN=
DZEN_DAILY_ARTICLES_ENABLED=true
DZEN_DAILY_ARTICLE_TIMES=12:00,19:00
DZEN_ARTICLE_WINDOWS=markets=11:30-12:00|18:30-19:00
DZEN_ARTICLE_RANDOMIZE_TIMES=true
DZEN_ARTICLE_SLOT_WINDOW_MINUTES=5
DZEN_ARTICLE_PARSE_MODE=HTML
DZEN_ARTICLE_FOOTER_ENABLED=false
DZEN_ARTICLE_FOOTER_POLICY=evening
DZEN_ARTICLE_FOOTER_ROTATE=true
DZEN_ARTICLE_FOOTER_TELEGRAM_URL=https://t.me/your_channel
DZEN_ARTICLE_FOOTER_VK_URL=https://vk.com/your_community
DZEN_ARTICLE_FOOTER_MAX_URL=https://max.ru/your_channel
DZEN_ARTICLE_MIN_POSTS=1
DZEN_ARTICLE_CANDIDATE_LIMIT=40
DZEN_ARTICLE_REVIEW_ENABLED=false
DZEN_ARTICLE_REVIEW_MAX_ATTEMPTS=5
DZEN_ARTICLE_REVIEW_TIMEOUT_HOURS=3
DZEN_ARTICLE_AUTO_PUBLISH_WEEKENDS=true
DZEN_ARTICLE_IMAGE_ENABLED=true
DZEN_ARTICLE_IMAGE_REQUIRED=true
DZEN_ARTICLE_IMAGE_CREDIT_ENABLED=false

# Pexels image search for visual article posts.
PEXELS_API_KEY=
PEXELS_API_BASE_URL=https://api.pexels.com
PEXELS_PHOTO_ORIENTATION=landscape
PEXELS_PHOTO_SIZE=large
PEXELS_PHOTO_PER_PAGE=12

# Translation and article generation. OpenRouter is the production path; local LLM is not required.
LLM_PROVIDER=openrouter
TRANSLATION_PROVIDER=openrouter
ARTICLE_LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_TRANSLATION_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_ARTICLE_MODEL=openai/gpt-5.6-terra

# Legacy local fallback only. Leave commented unless you deliberately bring Ollama back.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_TRANSLATION_MODEL=llama3.1:8b
# OLLAMA_ARTICLE_MODEL=llama3.1:8b

# Conservative platform guards. Tune after real API tests.
TELEGRAM_MAX_TEXT_CHARS=4096
VK_MAX_TEXT_CHARS=16350
MAX_MAX_TEXT_CHARS=4000
DZEN_POST_MAX_TEXT_CHARS=4096
TELEGRAM_PHOTO_CAPTION_MAX_CHARS=1024
DZEN_ARTICLE_TARGET_MIN_CHARS=650
DZEN_ARTICLE_TARGET_MAX_CHARS=950
SOCIAL_POST_MAX_LINES=3
SOCIAL_POST_TARGET_MAX_CHARS=700
PUBLISH_ORDER=vk,max,telegram
PUBLISH_MIN_SECONDS_BETWEEN_POSTS=180
